---
const { image, title, material, price, tag, type } = Astro.props;
const inquiryUrl = 'https://t.me/vafanasievav';
---
<article class="product-card" data-product-type={type}>
  <a class="product-card-link" href={inquiryUrl} target="_blank" rel="noopener" aria-label={`Уточнить наличие изделия «${title}»`}>
    <div class="product-image">
      <img src={image} alt={`${title} — ${material}`} loading="lazy" />
      {tag && <span>{tag}</span>}
    </div>
    <div class="product-copy">
      <div><h3>{title}</h3><p>{material}</p></div>
      <strong>{price}</strong>
    </div>
  </a>
</article>
